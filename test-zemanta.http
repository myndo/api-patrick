### Zemanta (Teads DSP) API Testing

# List all accounts
GET http://localhost:8000/api/v1/zemanta/accounts?includeArchived=false&includeDeliveryStatus=true

###

# Get account details
GET http://localhost:8000/api/v1/zemanta/accounts/186?includeDeliveryStatus=true

###

# Update account
PUT http://localhost:8000/api/v1/zemanta/accounts/186
Content-Type: application/json

{
  "name": "Updated Account Name",
  "frequencyCapping": 15,
  "targeting": {
    "publisherGroups": {
      "included": ["153"],
      "excluded": ["154"]
    }
  }
}

###

# Create new account
POST http://localhost:8000/api/v1/zemanta/accounts
Content-Type: application/json

{
  "name": "New Campaign Account",
  "agencyId": "1",
  "currency": "USD",
  "frequencyCapping": 10,
  "defaultBrandName": "My Brand Name",
  "defaultIconUrl": "https://example.com/logo.png",
  "inventoryAccessLevel": "EXPANDED"
}

###

# Get account sources
GET http://localhost:8000/api/v1/zemanta/accounts/186/sources

###

# Get account credits
GET http://localhost:8000/api/v1/zemanta/accounts/186/credits

###

# Get specific credit details
GET http://localhost:8000/api/v1/zemanta/accounts/186/credits/861

###

# Example with archived accounts
GET http://localhost:8000/api/v1/zemanta/accounts?includeArchived=true&includeDeliveryStatus=false

###

# Update account targeting
PUT http://localhost:8000/api/v1/zemanta/accounts/186
Content-Type: application/json

{
  "targeting": {
    "publisherGroups": {
      "included": ["153", "155"],
      "excluded": ["154"]
    },
    "keywordLists": {
      "excluded": ["123", "124"]
    }
  }
}

###

# Archive account
PUT http://localhost:8000/api/v1/zemanta/accounts/186
Content-Type: application/json

{
  "archived": true
}

###

# List campaigns with budgets and goals
GET http://localhost:8000/api/v1/zemanta/campaigns?includeArchived=false&includeGoals=true&includeBudgets=true&includeDeliveryStatus=true&accountId=186&excludeInactive=false

###

# List campaigns with stats for each campaign
GET http://localhost:8000/api/v1/zemanta/campaigns?includeArchived=false&includeBudgets=true&from=2026-01-01&to=2026-01-31

###

# List campaigns for specific account with stats
GET http://localhost:8000/api/v1/zemanta/campaigns?accountId=186&includeBudgets=true&from=2026-02-01&to=2026-02-18

###

# List only active campaigns with budgets
GET http://localhost:8000/api/v1/zemanta/campaigns?excludeInactive=true&includeBudgets=true

###

# Get campaign details (budgets only)
GET http://localhost:8000/api/v1/zemanta/campaigns/608

###

# Get campaign details with statistics (budgets + stats)
GET http://localhost:8000/api/v1/zemanta/campaigns/608?from=2026-01-01&to=2026-01-31

###

# Get campaign details with stats for another date range
GET http://localhost:8000/api/v1/zemanta/campaigns/608?from=2026-02-01&to=2026-02-18

###

# Sync all campaigns to database with stats
POST http://localhost:8000/api/v1/zemanta/sync-campaigns?from=2026-01-01&to=2026-01-31

