// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
// Prisma 7: url/directUrl are configured in prisma.config.ts

generator client {
  provider        = "prisma-client"
  output          = "./generated/prisma"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
}

model User {
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?
  id                 String             @id @default(uuid())
  email              String             @unique
  password           String?
  provider           String?
  name               String?
  confirmedAt        DateTime?
  integrationTokens  IntegrationToken[]
  providerProfiles   ProviderProfile[]
  tradeDoublerReports TradeDoublerReport[]
  providerJobs       ProviderJob[]
}

model ProviderJob {
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  id                 String             @id @default(uuid())
  userId             String
  profileId          String?
  provider           String             @default("tradedoubler")
  status             Int                @default(0)
  fromDate           DateTime
  toDate             DateTime
  reportCurrencyCode String?
  reportType         String?
  intervalType       String?
  completedAt        DateTime?
  errorMessage       String?            @db.Text
  rowsCount          Int                @default(0)
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile            ProviderProfile?   @relation(fields: [profileId], references: [id], onDelete: SetNull)
  reports            TradeDoublerReport[] @relation("ProviderJobToTradeDoublerReport")
  rtbReports         RTBHouseReport[]     @relation("ProviderJobToRTBHouseReport")
  zemantaReports     ZemantaReport[]      @relation("ProviderJobToZemantaReport")

  @@index([userId])
  @@index([profileId])
  @@index([provider])
  @@index([status])
}

model IntegrationToken {
  id           String    @id @default(uuid())
  userId       String
  profileId    String?
  provider     String    // "dv360" | "zemanta" | "rtbhouse" etc.
  accessToken  String    @db.Text
  refreshToken String?   @db.Text
  expiresAt    DateTime?
  scope        String?
  metadata     String?   @db.Text // encrypted JSON for provider-specific data
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile      ProviderProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@unique([profileId, provider])
  @@index([userId])
  @@index([profileId])
  @@index([provider])
}

model ProviderProfile {
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?
  id                String   @id @default(uuid())
  userId            String
  provider          String
  providerAccountId String?
  displayName       String?
  email             String?
  username          String?
  phone             String?
  address           String?
  city              String?
  country           String?
  currency          String?
  websiteUrl        String?
  rawData           String?  @db.Text
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  integrationTokens IntegrationToken[]
  providerJobs      ProviderJob[]

  @@unique([userId, provider, providerAccountId])
  @@index([userId, provider])
  @@index([userId])
  @@index([provider])
}

model RTBHouseReport {
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  id               String    @id @default(uuid())
  userId           String?
  profileId        String?
  day              DateTime?
  campaign         String?
  investment       Float?
  status           String?
  clicksCount      Int       @default(0)
  conversionsCount Int       @default(0)
  clientName       String?
  conversionsValue Float?    @default(0)
  country          String?
  currency         String?
  impsCount        Int       @default(0)
  campaignCost     Float?    @default(0)
  userSegment      String?
  provider         String?
  providerJobId    String?
  providerJob      ProviderJob? @relation("ProviderJobToRTBHouseReport", fields: [providerJobId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([profileId])
  @@index([providerJobId])
}

model TopQuery {
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  id          String    @id @default(uuid())
  siteUrl     String
  query       String
  clicks      Int       @default(0)
  impressions Int       @default(0)
  ctr         Float     @default(0)
  position    Float     @default(0)
  startDate   DateTime
  endDate     DateTime

  @@index([siteUrl, startDate, endDate])
  @@index([query])
}

model TopPage {
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  id          String    @id @default(uuid())
  siteUrl     String
  page        String
  clicks      Int       @default(0)
  impressions Int       @default(0)
  ctr         Float     @default(0)
  position    Float     @default(0)
  startDate   DateTime
  endDate     DateTime

  @@index([siteUrl, startDate, endDate])
  @@index([page])
}

model PerformanceByCountry {
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  id          String    @id @default(uuid())
  siteUrl     String
  country     String
  clicks      Int       @default(0)
  impressions Int       @default(0)
  ctr         Float     @default(0)
  position    Float     @default(0)
  startDate   DateTime
  endDate     DateTime

  @@index([siteUrl, startDate, endDate])
  @@index([country])
}

model PerformanceByDevice {
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  id          String    @id @default(uuid())
  siteUrl     String
  device      String
  clicks      Int       @default(0)
  impressions Int       @default(0)
  ctr         Float     @default(0)
  position    Float     @default(0)
  startDate   DateTime
  endDate     DateTime

  @@index([siteUrl, startDate, endDate])
  @@index([device])
}

model ZemantaReport {
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?
  id                String   @id // budget ID when available, otherwise campaign-{campaignId}
  providerJobId     String?
  userId            String?
  profileId         String?
  campaignId        String
  budgetId          String?
  accountId         String
  accountName       String?
  currency          String?
  agencyName        String?
  campaignManager   String?
  campaignName      String
  archived          Boolean  @default(false)
  iabCategory       String?
  frequencyCapping  Int?
  deliveryStatus    String?
  totalCost         String?
  impressions       Int?
  clicks            Int?
  cpc               String?
  statsFrom         DateTime?
  statsTo           DateTime?
  creditId          String?
  amount            String?
  margin            String?
  comment           String?
  budgetStartDate   DateTime?
  budgetEndDate     DateTime?
  budgetState       String?
  spend             String?
  available         String?
  providerJob       ProviderJob? @relation("ProviderJobToZemantaReport", fields: [providerJobId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([budgetId])
  @@index([providerJobId])
  @@index([userId])
  @@index([profileId])
  @@index([accountId])
  @@index([archived])
  @@index([statsFrom, statsTo])
  @@index([budgetState])
}

model TradeDoublerReport {
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?
  id                  String    @id @default(uuid())
  userId              String
  profileId           String?
  jobId               String?
  date                DateTime
  organizationName    String
  organizationId      String
  campaignName        String
  programId           String
  currency            String
  country             String?
  publisherCommission Float     @default(0)
  orderValue          Float     @default(0)
  totalCommission     Float     @default(0)
  vatAmount           Float     @default(0)
  impressions         Int       @default(0)
  clicks              Int       @default(0)
  currencyCode        String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  job                 ProviderJob? @relation("ProviderJobToTradeDoublerReport", fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId, date, organizationId, programId, country])
  @@index([userId])
  @@index([profileId])
  @@index([jobId])
  @@index([date])
  @@index([organizationId])
  @@index([programId])
  @@index([country])
}
