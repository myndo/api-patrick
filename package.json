{
  "name": "vedcausa",
  "version": "0.0.1",
  "description": "A simple nest-prisma app",
  "author": "Boclair Temgoua",
  "private": true,
  "license": "UNLICENSED",
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "scripts": {
    "build": "NODE_OPTIONS=--max-old-space-size=3072 nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "NODE_OPTIONS=--max-old-space-size=3072 nest start",
    "dev": "NODE_OPTIONS=--max-old-space-size=3072 nest start --watch",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
	"pm2:start": "pm2 start ecosystem.config.js",
  "pm2:start:api": "pm2 start ecosystem.config.js --only api",
  "pm2:start:workers": "pm2 start ecosystem.config.js --only tradedoubler-worker,rtbhouse-worker,zemanta-worker",
  "pm2:stop": "pm2 stop ecosystem.config.js",
  "pm2:restart": "pm2 restart ecosystem.config.js",
  "pm2:reload": "pm2 reload ecosystem.config.js",
  "pm2:delete": "pm2 delete ecosystem.config.js",
  "pm2:status": "pm2 status",
  "pm2:logs": "pm2 logs",
  "pm2:logs:api": "pm2 logs api",
  "pm2:monit": "pm2 monit",
  "pm2:save": "pm2 save",
	"pm2:startup": "pm2 startup systemd -u $USER --hp $HOME",
"pm2:unstartup": "pm2 unstartup systemd",
  "deploy": "git pull && npm install && npm run db:migrate && npm run build && npm run pm2:reload && npm run pm2:save"

  },
  "dependencies": {
    "@nestjs/cli": "^11.0.21",
