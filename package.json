    "@prisma/client": "^7.3.0",
    "@stripe/react-stripe-js": "^5.6.0",
    "@stripe/stripe-js": "^8.7.0",
    "@types/mime": "^4.0.0",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^0.10.9",
    "argon2": "^0.44.0",
    "aws-sdk": "^2.1693.0",
    "axios": "^1.13.4",
    "chalk": "^5.6.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cookie-parser": "^1.4.7",
    "cross-var": "^1.1.0",
    "csurf": "^1.11.0",
    "csv-parser": "^3.2.0",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.19",
    "exceljs": "^4.4.0",
    "fast-csv": "^5.0.5",
    "geoip-lite": "^1.4.10",
    "google-auth-library": "^10.5.0",
    "handlebars": "^4.7.8",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "mailgun.js": "^12.7.0",
    "mime": "^4.1.0",
    "mime-types": "^3.0.2",
    "mysql2": "^3.16.2",
    "node-mailjet": "^6.0.11",
    "nodemailer": "^7.0.13",
    "nodemailer-smtp-transport": "^2.7.4",
    "number-generator": "^4.0.6",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "pdfmake": "^0.2.23",
    "pg": "^8.18.0",
    "qrcode": "^1.5.4",
    "resend": "^6.9.1",
    "s3": "^4.4.0",
    "slugify": "^1.6.6",
    "stripe": "^20.3.0",
    "twilio": "5.12.0",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5",
    "xml2js": "^0.6.2"
