# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/database_name?schema=public"

# Application Configuration
NODE_ENV=development
PORT=8000
 
 
# Shopify Configuration
SHOPIFY_API_KEY=secret_api_key_here
SHOPIFY_API_SECRET=secret_api_secret_here
SHOPIFY_HOST_NAME=localhost:8000
 
# Zemanta Configuration
ZEMANTA_CLIENT_ID=secret_client_id_here
ZEMANTA_CLIENT_SECRET=secret_client_secret_here
 
# TradeDoubler Configuration
TRADEDOUBLER_SECRET=secret_key_here
TRADEDOUBLER_CLIENT_ID=secret_client_id_here
TRADEDOUBLER_USERNAME=secret_username_here
TRADEDOUBLER_PASSWORD=secret_password_here
TRADEDOUBLER_BASE_URL=https://connect.tradedoubler.com  



# Adform Configuration
ADFORM_CLIENT_ID=your_adform_client_id
ADFORM_CLIENT_SECRET=your_adform_client_secret
ADFORM_SCOPES=https://api.adform.com/scope/buyer.stats https://api.adform.com/scope/buyer.stats.metadata https://api.adform.com/scope/buyer.advertisers https://api.adform.com/scope/ndw.addresses https://api.adform.com/scope/agencies.readonly

# Integration Token Encryption (32-char key for AES-256, required in production)
TOKEN_ENCRYPTION_KEY=your_32_character_encryption_key_here
